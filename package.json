{
  "name": "badmark-studio",
  "description": "红人馆AI本机服装改款与成片管理工作台",
  "author": "红人馆AI",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BANKO-HUI/hongrenguan-ai.git"
  },
  "bugs": {
    "url": "https://github.com/BANKO-HUI/hongrenguan-ai/issues"
  },
  "homepage": "https://github.com/BANKO-HUI/hongrenguan-ai#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "3.4.4",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/start.js",
    "open": "node scripts/launch.js",
    "mcp": "node server/mcp.js",
    "plugin:install": "node scripts/install-plugin.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "master:package": "node scripts/package-master-kit.js",
    "master:verify": "node scripts/verify-master-kit.js",
    "desktop:icon": "node scripts/build-desktop-icon.js",
    "desktop:deps:win": "npm install --force --no-save --include=optional --os=win32 --cpu=x64",
    "desktop:dir": "npm run build && npm run desktop:icon && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && npm run desktop:icon && electron-builder --mac dmg --publish never",
    "desktop:dist:win": "npm run build && npm run desktop:icon && npm run desktop:deps:win && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.8",
    "@openai/codex": "0.163.0",
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "multer": "^2.3.0",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.4",
    "vite": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "40.10.2",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.6"
  }
}
